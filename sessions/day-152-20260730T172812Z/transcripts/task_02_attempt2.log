fn exit_with_state(code: i32) -> ! {
    let status = if code == 0 { "completed" } else { "error" };
    if code != 0 {
        let diag = state::take_diagnostic_error();
        state::record(
            state::EventType::FailureObserved,
            state::Actor::Harness,
            serde_json::json!({
                "source": "agent_error_exit",
                "exit_code": code,
                "error_detail": diag,
            }),
        );
        // Re-stash for mark_run_completed_with_error to include in RunCompleted
        if let Some(ref msg) = diag {
            state::stash_diagnostic_error(msg);
        }
        state::mark_run_completed_with_error(&format!("exit code {}", code));
    } else {
        state::mark_run_completed(status);
    }
    std::process::exit(code);
}
```

