```rust
fn read_trace_events(path: &Path, id: &str) -> Result<Vec<Value>, String> {
    const CHUNK: usize = 20_000;
    const MAX_SCAN: usize = 200_000;
    
    let file = std::fs::File::open(path)
        .map_err(|e| format!("cannot open state log: {e}"))?;
    let file_size = file.metadata()
        .map_err(|e| format!("cannot read state log metadata: {e}"))?.len();
    
    // Read from the tail in chunks, collecting matching events.
    // Stop when we've seen RunStarted and are past the trace window.
    let mut matched: Vec<Value> = Vec::new();
    let mut offset = file_size;
    let mut total = 0usize;
    let mut found_start = false;
    
    while offset > 0 && total < MAX_SCAN {
        let chunk_lines = read_file_tail_chunk(&file, offset, CHUNK)?;
        total += chunk_lines.len();
        
        let mut any_match = false;
        // Process in reverse (newest first) since we read from the tail
        for line in chunk_lines.iter().rev() {
            let event: Value = serde_json::from_str(line)
                .map_err(|e| format!("invalid event JSON: {e}"))?;
            let matches = event_string(&event, "run_id").map_or(false, |r| r == id)
                || event_string(&event, "trace_id").map_or(false, |t| t == id);
            if matches {
                if event_string(&event, "event_type").map_or(false, |t| t == "RunStarted") {
                    found_start = true;
                }
                matched.push(event);
                any_match = true;
            }
        }
        
        if found_start && !any_match {
            break;
        }
        
        // Move offset back by estimated bytes
        offset = offset.saturating_sub((CHUNK as u64) * 500 * 3);
    }
    
    if matched.is_empty() {
        return Err(format!("no state trace found for '{id}'"));
    }
    
    matched.reverse();  // restore chronological order
    Ok(matched)
}
```

