```rust
fn read_trace_events(path: &Path, id: &str) -> Result<Vec<Value>, String> {
    const CHUNK_SIZE: usize = 20_000;  // Events per reverse chunk
    const MAX_TOTAL_SCAN: usize = 200_000;  // Safety cap
    
    let file = std::fs::File::open(path).map_err(|e| format!("cannot open state log: {e}"))?;
    let file_size = file.metadata().map_err(|e| format!("cannot read state log metadata: {e}"))?.len();
    
    const EST_BYTES_PER_LINE: u64 = 500;
    let chunk_bytes = (CHUNK_SIZE as u64).saturating_mul(EST_BYTES_PER_LINE).saturating_mul(3);
    
    let mut matched: Vec<Value> = Vec::new();
    let mut scan_offset = file_size;
    let mut total_scanned = 0usize;
    let mut found_run_started = false;
    
    while scan_offset > 0 && total_scanned < MAX_TOTAL_SCAN {
        let chunk_start = scan_offset.saturating_sub(chunk_bytes);
        // Read events in this byte range
        let events_in_chunk = read_events_in_range(path, chunk_start, scan_offset)?;
        total_scanned += events_in_chunk.len();
        
        let mut chunk_matched = false;
        for event in events_in_chunk.iter().rev() {
            let matches = event_string(event, "run_id").map(|r| r == id).unwrap_or(false)
                || event_string(event, "trace_id").map(|t| t == id).unwrap_or(false);
            if matches {
                matched.push(event.clone());
                chunk_matched = true;
                if event_string(event, "event_type").map(|t| t == "RunStarted").unwrap_or(false) {
                    found_run_started = true;
                }
            }
        }
        
        // Stop if we've found the trace start and the current chunk had no matches
        if found_run_started && !chunk_matched {
            break;
        }
        
        if chunk_start == 0 {
            break;
        }
        scan_offset = chunk_start;
    }
    
    if matched.is_empty() {
        return Err(format!("no state trace found for '{id}'"));
    }
    
    // Reverse to restore forward chronological order
    matched.reverse();
    Ok(matched)
}
```

