```python
def _validate_files_list(files_str: str) -> tuple[str, list[str]]:
    """Validate each file path against git-tracked files.
    
    Returns (cleaned_files_str, dropped_paths).
    Strips leading './', checks for git tracking.
    Drops paths that are not git-tracked files.
    """
    tracked = _git_tracked_files()
    valid: list[str] = []
    dropped: list[str] = []
    for path in files_str.split(","):
        path = path.strip()
        if not path:
            continue
        # Strip leading './'
        clean = path.removeprefix("./")
        if tracked is not None:
            if clean in tracked:
                valid.append(clean)
            else:
                dropped.append(path)
        else:
            # Git unavailable, fall back to os.path.isfile
            if os.path.isfile(clean):
                valid.append(clean)
            else:
                dropped.append(path)
    return ", ".join(valid), dropped
```

