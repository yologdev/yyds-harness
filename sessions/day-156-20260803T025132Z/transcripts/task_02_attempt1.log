The helper function:
```rust
/// For a given run_id, find all ModelCallStarted events that lack a matching
/// ModelCallCompleted and emit the missing ModelCallCompleted with status
/// "interrupted" and error_detail "orphaned_at_startup".
fn close_orphaned_model_calls_for_run(
    events_path: &Path,
    store_path: Option<&Path>,
    events: &[Value],
    run_id: &str,
) -> Result<(), String> {
    let mut started_ids: HashSet<String> = HashSet::new();
    let mut completed_ids: HashSet<String> = HashSet::new();
    
    for event in events {
        let et = event.get("event_type").and_then(|v| v.as_str()).unwrap_or("");
        let r = event.get("run_id").and_then(|v| v.as_str()).unwrap_or("");
        if r != run_id {
            continue;
        }
        let mc_id = event
            .get("payload")
            .and_then(|v| v.get("model_call_id"))
            .and_then(|v| v.as_str());
        if let Some(id) = mc_id {
            if et == "ModelCallStarted" {
                started_ids.insert(id.to_string());
            } else if et == "ModelCallCompleted" {
                completed_ids.insert(id.to_string());
            }
        }
    }
    
    for id in &started_ids {
        if completed_ids.contains(id) {
            continue;
        }
        let event = StateEvent {
            event_id: format!("evt-orphan-mc-{}", now_ms()),
            event_type: EventType::ModelCallCompleted,
            schema_version: STATE_SQLITE_SCHEMA_VERSION,
            timestamp_ms: now_ms(),
            actor: Actor::Harness,
            run_id: Some(run_id.to_string()),
            session_id: None,
            trace_id: format!("trace-orphan-mc-{}", run_id),
            parent_event_ids: Vec::new(),
            payload: json!({
                "model_call_id": id,
                "model": "",
                "status": "interrupted",
                "detail": "orphaned_at_startup",
                "input_tokens": 0,
                "output_tokens": 0,
                "thinking_observed": false,
            }),
        };
        append_event_with_projection(events_path, store_path, &event)?;
    }
    Ok(())
}
```

